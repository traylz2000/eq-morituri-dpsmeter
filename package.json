{
  "name": "eq-morituri-dpsmeter",
  "version": "0.2.1",
  "description": "DPS meter and combat history for the Project Morituri EverQuest server, read from your EverQuest logs. Forked from Triune-Helper.",
  "main": "./out/main/index.js",
  "author": "traylz2000",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "start": "node scripts/dev.mjs preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "node scripts/replay.mjs",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "bundle": "node scripts/bundle.mjs",
    "release": "npm run package && npm run bundle"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
